---
import BrowserFrame from "./BrowserFrame.astro";
import TechTag from "./TechTag.astro";

interface Props {
  title: string;
  tagline: string;
  description: string;
  status: string;
  technologies: string[];
  href: string;
  previewUrl: string;
  previewSrc?: string;
}

const { title, tagline, description, status, technologies, href, previewUrl, previewSrc } =
  Astro.props;
---

<article class="project-card">
  <div class="body">
    <p class="card-label">{status}</p>
    <h2><a href={href}>{title}</a></h2>
    <p class="tagline">{tagline}</p>
    <p>{description}</p>
    <ul class="tag-list" aria-label="Technologies">
      {technologies.map((technology) => <TechTag>{technology}</TechTag>)}
    </ul>
    <span class="text-link" aria-hidden="true">Read case study →</span>
  </div>
  <div class="preview">
    <BrowserFrame url={previewUrl} src={previewSrc} alt={`${title} screenshot`} height="260px" />
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition:
      transform 200ms ease,
      border-color 200ms ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .body {
    display: flex;
    flex: 1 1 360px;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .body > * {
    margin: 0;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tagline {
    margin-top: -0.4rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .preview {
    flex: 1 1 420px;
    min-width: 0;
  }

  @media (max-width: 640px) {
    .project-card {
      padding: 1.35rem;
    }
  }
</style>
