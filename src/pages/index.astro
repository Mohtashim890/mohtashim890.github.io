
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mohtashim Ul Haq | .NET, Agentic AI & SaaS Engineering"
  description="Software engineer focused on .NET applications, agentic AI integrations, SaaS architecture, and cloud deployment."
>
  <section class="hero section">
    <div class="container">
      <p class="eyebrow">Software engineering · Agentic AI</p>

      <h1>
        Building intelligent software products
        <span>from API to production.</span>
      </h1>

      <p class="intro">
        I develop .NET applications, agent-enabled SaaS platforms,
        API integrations, and cross-platform experiences—with a focus
        on architecture, reliability, and deployment.
      </p>

      <div class="actions">
        <a class="button button-primary" href="/projects/ironforge/">
          Explore IronForge
        </a>
        <a class="button" href="/contact/">
          Get in touch
        </a>
      </div>

      <div class="skills" aria-label="Core technologies">
        <span>C# / .NET</span>
        <span>Blazor</span>
        <span>MAUI Hybrid</span>
        <span>ASP.NET Core APIs</span>
        <span>MCP</span>
        <span>Agentic AI</span>
        <span>Docker / CI/CD</span>
      </div>
    </div>
  </section>

  <section class="section featured">
    <div class="container">
      <p class="eyebrow">Featured project</p>
      <h2>Engineering IronForge</h2>

      <div class="project-card card">
        <div>
          <h3>An agentic SaaS platform</h3>
          <p>
            IronForge brings together a .NET web application, APIs,
            MCP server and client integrations, cross-platform
            application development, and cloud deployment.
          </p>
          <a href="/projects/ironforge/">Read the technical case study →</a>
        </div>

        <div class="project-status">
          <span>FLAGSHIP PROJECT</span>
          <p>End-to-end engineering</p>
          <p>Cloud deployment</p>
          <p>Agent and tool integration</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What I do</p>
      <h2>Engineering capabilities</h2>

      <div class="capabilities">
        <article class="card">
          <h3>.NET application development</h3>
          <p>Web applications, APIs, business workflows, and maintainable application architecture.</p>
        </article>

        <article class="card">
          <h3>Agentic AI integration</h3>
          <p>Tool-enabled workflows, MCP integrations, and practical AI capabilities with clear boundaries.</p>
        </article>

        <article class="card">
          <h3>Deployment and delivery</h3>
          <p>Containerization, automated builds, deployment workflows, and production configuration.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 6rem;
  }

  h1 span {
    display: block;
    color: var(--color-accent);
  }

  .intro {
    max-width: 720px;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: 2rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 3rem;
  }

  .skills span,
  .project-status span {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(200px, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .project-card p {
    max-width: 680px;
  }

  .project-status {
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  .project-status span {
    display: inline-block;
    color: var(--color-accent);
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 700px) {
    .hero {
      padding-top: 3.5rem;
    }

    .project-card,
    .capabilities {
      grid-template-columns: 1fr;
    }

    .project-status {
      border-left: 0;
      border-top: 1px solid var(--color-border);
      padding: 1.5rem 0 0;
    }
  }
</style>
