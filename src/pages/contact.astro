
---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactEmail = "mohtashimulhaq34@gmail.com";
const linkedInUrl = "https://www.linkedin.com/in/mohtashim-ul-haq";
const githubUrl = "https://github.com/mohtashim890";

const emailConfigured = !contactEmail.startsWith("REPLACE_");
const linkedInConfigured = linkedInUrl.startsWith("https://");
---

<BaseLayout
  title="Contact | Mohtashim Ul Haq"
  description="Contact Mohtashim Ul Haq about .NET engineering opportunities, SaaS development, AI integration, and software projects."
>
  <section class="container section contact-page">
    <p class="eyebrow">Contact</p>
    <h1>Let's discuss a software engineering problem.</h1>

    <p class="lead">
      For engineering opportunities, project enquiries, or technical
      collaboration, you can reach me through the professional channels
      below.
    </p>

    <div class="contact-options">
      {emailConfigured && (
        <a class="card contact-card" href={`mailto:${contactEmail}`}>
          <span class="contact-label">Email</span>
          <h2>Send an email</h2>
          <p>{contactEmail}</p>
        </a>
      )}

      {linkedInConfigured && (
        <a
          class="card contact-card"
          href={linkedInUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-label">Professional network</span>
          <h2>Connect on LinkedIn</h2>
          <p>View my professional profile.</p>
        </a>
      )}

      <a
        class="card contact-card"
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-label">Source code</span>
        <h2>GitHub</h2>
        <p>Explore my repositories and engineering work.</p>
      </a>
    </div>

    <p class="small-note">
      Please replace the email and LinkedIn placeholders before publishing.
      This static page does not send or store contact form submissions.
    </p>
  </section>
</BaseLayout>

<style>
  .contact-page {
    max-width: 900px;
  }

  .contact-page > .eyebrow {
    margin-top: 2rem;
  }

  .lead {
    max-width: 700px;
    font-size: 1.15rem;
  }

  .contact-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 2.5rem;
  }

  .contact-card {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-card:hover {
    border-color: var(--color-accent);
  }

  .contact-label {
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .contact-card h2 {
    margin-top: 1rem;
    font-size: 1.35rem;
  }

  .contact-card p {
    margin-bottom: 0;
    overflow-wrap: anywhere;
  }

  .small-note {
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .contact-options {
      grid-template-columns: 1fr;
    }
  }
</style>
