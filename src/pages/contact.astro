---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const channels = [
  {
    label: "Email",
    title: "Send an email",
    detail: site.email,
    href: `mailto:${site.email}`,
    external: false,
  },
  {
    label: "Professional network",
    title: "Connect on LinkedIn",
    detail: "View my professional profile.",
    href: site.linkedInUrl,
    external: true,
  },
  {
    label: "Source code",
    title: "GitHub",
    detail: "Explore my repositories, including IronForge.",
    href: site.githubUrl,
    external: true,
  },
];
---

<BaseLayout
  title="Contact | Mohtashim Ul Haq"
  description="Contact Mohtashim Ul Haq about .NET engineering roles, SaaS development, AI agent integration and software projects."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Contact</p>
      <h1>Have a role or a project <span class="accent">in mind?</span></h1>
      <p class="lead">
        For engineering roles, project enquiries or technical collaboration,
        reach me through any of the channels below. I usually reply within a
        day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-auto">
        {channels.map((channel) => (
          <a
            class="card contact-card"
            href={channel.href}
            target={channel.external ? "_blank" : undefined}
            rel={channel.external ? "noopener noreferrer" : undefined}
          >
            <span class="card-label">{channel.label}</span>
            <h2>{channel.title}</h2>
            <p>{channel.detail}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card h2 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1.35rem;
  }

  .contact-card p {
    overflow-wrap: anywhere;
  }
</style>
