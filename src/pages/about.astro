---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
import { ironforge } from "../data/ironforge";

const interests = [
  "Reliable, maintainable .NET application architecture",
  "Agentic systems and tool-based integrations",
  "API design, authorization and integration boundaries",
  "Cross-platform application development",
  "Cloud deployment, testing and operational reliability",
  "Practical applications of data science and machine learning",
];
---

<BaseLayout
  title="About | Mohtashim Ul Haq"
  description="Professional background, software engineering interests, and postgraduate study in Data Science at Universiti Sains Malaysia."
>
  <section class="page-hero">
    <div class="container page-hero-inner about-hero">
      <div class="about-hero-copy">
        <p class="eyebrow">About</p>
        <h1>Software engineering with a <span class="accent">systems perspective.</span></h1>
        <p class="lead">
          I work across application architecture, APIs, integrations and
          deployment. My current project, IronForge, brings these disciplines
          together in a production-grade, agentic SaaS platform.
        </p>
      </div>
      <img
        class="about-photo"
        src={site.photo}
        alt="Portrait of Mohtashim Ul Haq"
        width="320"
        height="400"
      />
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">
      <div class="about-main">
        <section>
          <h2>Professional focus</h2>
          <p>
            My engineering interests include maintainable .NET applications,
            distributed application boundaries, AI-enabled workflows, tool
            integrations and reliable software delivery.
          </p>
          <p>
            I value practical implementation: defining component
            responsibilities, documenting trade-offs, validating behaviour,
            and making software reproducible to build and deploy.
          </p>
        </section>

        <section>
          <h2>Areas of interest</h2>
          <ul class="check-list">
            {interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </section>
      </div>

      <aside class="about-side" aria-label="Highlights">
        <div class="card">
          <span class="card-label">Education · in progress</span>
          <h3>Master's in Data Science</h3>
          <p class="institution">Universiti Sains Malaysia (USM)</p>
          <p>
            Postgraduate study that complements my engineering work with
            data-driven methods and their use in software systems.
          </p>
        </div>

        <a class="card" href={ironforge.href}>
          <span class="card-label">Current project</span>
          <h3>{ironforge.name}</h3>
          <p>{ironforge.tagline}, built solo on .NET 10.</p>
          <span class="text-link">Read the case study →</span>
        </a>

        <div class="card">
          <span class="card-label">Résumé</span>
          <p>Experience, technical skills and education on one page.</p>
          <a class="button button-dark button-small" href={site.resumeUrl} download>
            Download résumé (PDF)
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand title="Let's work together" text="Open to full-time roles and freelance projects.">
    <a class="button button-dark" href="/contact/">Get in touch</a>
    <a class="button" href="/services/">See services</a>
  </CtaBand>
</BaseLayout>

<style>
  .about-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3rem;
  }

  .about-hero-copy {
    flex: 1 1 560px;
    min-width: 0;
  }

  .about-photo {
    flex: 0 1 280px;
    width: 280px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    padding: 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .about-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 3rem;
  }

  .about-main {
    display: flex;
    flex: 999 1 520px;
    flex-direction: column;
    gap: 3rem;
    min-width: 0;
  }

  .about-main h2 {
    margin-bottom: 1.1rem;
    font-size: 1.85rem;
  }

  .about-side {
    display: flex;
    flex: 1 1 320px;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .about-side h3 {
    margin-bottom: 0.35rem;
  }

  .about-side p {
    margin-bottom: 0.9rem;
    font-size: 0.94rem;
  }

  .institution {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
