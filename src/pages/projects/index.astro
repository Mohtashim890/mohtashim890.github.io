---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { ironforge } from "../../data/ironforge";

const projects = [
  {
    title: ironforge.name,
    tagline: ironforge.tagline,
    description: ironforge.summary,
    status: "Flagship project · 2026",
    technologies: [".NET 10", "Blazor", ".NET MAUI", "PostgreSQL", "MCP", "Stripe Connect", "Docker"],
    href: ironforge.href,
    previewUrl: "mohtashim.dev",
  },
];
---

<BaseLayout
  title="Work | Mohtashim Ul Haq"
  description="Selected software engineering work, with technical case studies covering architecture, implementation and deployment."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Selected work</p>
      <h1>Products built for <span class="accent">production.</span></h1>
      <p class="lead">
        Each case study covers the problem, the architecture, the hard parts
        and how it ships.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container project-list">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <CtaBand title="Want something like this built?" text="Tell me about the product you have in mind.">
    <a class="button button-dark" href="/contact/">Get in touch</a>
    <a class="button" href="/services/">See services</a>
  </CtaBand>
</BaseLayout>

<style>
  .project-list {
    display: grid;
    gap: 1rem;
  }
</style>
